PORT=3000

# Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Publishable/anon key - used only by the backend for password authentication
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# SECRET - never put this in public/ or frontend JavaScript
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Admin email allowed to manage contents
ADMIN_EMAIL=admin@example.com
